{
  "name": "overhead",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "app"
  ],
  "scripts": {
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint shared server && npm run lint -w app",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
